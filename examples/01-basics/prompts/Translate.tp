<template name="Translate">
  <schema>
    interface Input {
      text: string;
      targetLanguage: string;
    }

    type Output = string;
  </schema>

  <system>
    You are a professional translator. Translate the given text into the requested
    language. Output only the translated text — no explanations, no commentary.
  </system>

  <user>
    Translate the following text into <insert val="input.targetLanguage" />:

    <enclosed tag="Text">
      <insert val="input.text" />
    </enclosed>
  </user>

  <examples>
    - input:
        text: The meeting is scheduled for Monday at 3 PM.
        targetLanguage: French
      output: La réunion est prévue pour lundi à 15h.

    - input:
        text: Please review the attached document.
        targetLanguage: Spanish
      output: Por favor, revise el documento adjunto.
  </examples>
</template>
