<!-- Template 2: generates a return label slip -->
<template name="ReturnSlip">
  <meta>
    model: gpt-4o
    temperature: 0.2
  </meta>

  <schema output-format="text">
    interface Input {
      customer: shared.ContactInfo;
      returnReason: "defective" | "wrongItem" | "changedMind" | "other";
      orderNumber: string;
    }

    type Output = string;
  </schema>

  <system>
    Generate a short return slip to be printed and included in the return
    package. Include the customer name, return address, order number, and
    reason code.
  </system>

  <user>
    <insert val="input" format="json" />
  </user>

  <examples>
    - input:
        customer:
          name: "Bob Jones"
          email: "bob@example.com"
          address:
            street: "456 Elm Ave"
            city: "Seattle"
            country: "USA"
            postalCode: "98101"
        returnReason: defective
        orderNumber: "ORD-2045"
      output: |
        RETURN AUTHORIZATION SLIP
        =========================
        Order Number: ORD-2045
        Customer: Bob Jones
        Return Address: 456 Elm Ave, Seattle, USA 98101
        Reason: defective

        Please place this slip inside your package before sealing.
  </examples>
</template>
