<template name="TriageTicket">
  <meta>
    model: gpt-4o
    temperature: 0.2
  </meta>

  <schema>
    /** A support ticket to be triaged. */
    interface Input {
      subject: string;
      body: string;
      customerTier: "free" | "pro" | "enterprise";
      /** Previous tickets from this customer, for context. */
      recentTickets: {
        id: string;
        summary: string;
        category: TicketCategory;
      }[];
    }

    type TicketCategory = "billing" | "technical-issue" | "feature-request" | "other";

    interface Output {
      category: TicketCategory;

      /** How quickly this ticket needs attention. */
      urgency: "low" | "medium" | "high" | "critical";

      /** One-sentence summary of the issue. */
      summary: string;

      /** Concrete next steps to resolve the ticket. */
      suggestedActions: string[];

      /** Suggested first reply to the customer, if the issue is straightforward. */
      suggestedReply?: string;
    }
  </schema>

  <system>
    You are a support ticket triage assistant. Analyze the ticket and return a
    structured assessment. Set <c>urgency</c> to <c>"critical"</c> only when
    the user reports data loss or a complete service outage. For
    <c>"enterprise"</c> customers, bump urgency one level higher than you would
    for other tiers.
  </system>

  <user>
    <!-- format="toon" is another good choice for structured LLM-readable output -->
    <insert val="input" format="yaml" />
  </user>

  <examples>
    - input:
        subject: Dashboard won't load since yesterday
        body: Our whole team is blocked — it just shows a spinner.
        customerTier: enterprise
        recentTickets:
          - id: T-201
            summary: Slow report exports
            category: technical-issue
          - id: T-184
            summary: Billing invoice discrepancy
            category: billing
      output:
        category: technical-issue
        urgency: critical
        summary: >-
          Enterprise customer's dashboard is completely unavailable,
          blocking the entire team.
        suggestedActions:
          - Escalate to on-call engineer immediately
          - Check recent deploy logs for regressions
          - Send acknowledgement within 15 minutes
        suggestedReply: >-
          We've escalated this to our engineering team as a top priority.
          You'll hear from us within 15 minutes.

    - input:
        subject: Can you add CSV export to the reports page?
        body: It would save us a lot of time if we could download reports as CSV.
        customerTier: pro
        recentTickets: []
      output:
        category: feature-request
        urgency: low
        summary: Customer requests CSV export for the reports page.
        suggestedActions:
          - Log in the feature request tracker
          - Acknowledge the request and share the roadmap link
  </examples>
</template>
