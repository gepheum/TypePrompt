<template name="DetectAnomaly" namespace="Finance">
  <meta>
    model: gpt-4o
    temperature: 0.2
  </meta>

  <schema>
    interface Input {
      recentTransactions: {
        description: string;
        amount: shared.MoneyAmount;
        date: string;
      }[];
      newTransaction: {
        description: string;
        amount: shared.MoneyAmount;
        date: string;
      };
    }

    interface Output {
      isAnomaly: boolean;
      reason?: string;
    }
  </schema>

  <system>
    You are a fraud detection assistant. Given a list of recent transactions
    and a new transaction, determine whether the new transaction looks
    anomalous. An anomaly might be an unusual amount, an unfamiliar merchant,
    or an atypical time pattern.
  </system>

  <user>
    Recent transactions:
    <insert val="input.recentTransactions" format="json" />

    New transaction:
    <insert val="input.newTransaction" format="json" />
  </user>

  <examples>
    - input:
        recentTransactions:
          - description: Coffee Shop
            amount:
              value: 5.5
              currency: USD
            date: "2026-10-10"
          - description: Grocery Store
            amount:
              value: 62.1
              currency: USD
            date: "2026-10-11"
        newTransaction:
          description: Luxury Jewelry Boutique
          amount:
            value: 4800.0
            currency: USD
          date: "2026-10-12"
      output:
        isAnomaly: true
        reason: >-
          Transaction amount of $4,800.00 is significantly higher than
          recent spending history, and the merchant is unfamiliar.

    - input:
        recentTransactions:
          - description: Gas Station
            amount:
              value: 45.0
              currency: USD
            date: "2026-10-09"
        newTransaction:
          description: Supermarket
          amount:
            value: 52.3
            currency: USD
          date: "2026-10-12"
      output:
        isAnomaly: false
  </examples>
</template>
