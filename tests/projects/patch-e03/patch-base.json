    "prompts/Bar/MyOtherTemplate.xml": "<template name=\"MyOtherTemplate\" namespace=\"Bar\">\n  <schema>\n    type Input = shared.Square[];\n\n    type Output = {\n      reversedText: string;\n      shape: shared.Square | { kind: \"circle\"; radius: number };\n    }[];\n  </schema>\n\n  <tools>\n    - tool: myOtherTool\n  </tools>\n\n  <user>\n    U\n  </user>\n  <system>\n    S\n  </system>\n</template>\n"
