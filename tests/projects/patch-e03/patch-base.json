    "prompts/Foo/shared.xml": "<namespace name=\"Foo\">\n  type Foos = string[];\n\n  type Square = {\n    kind: \"square\";\n    size: number;\n  };\n</namespace>\n",
    "prompts/Foo/myTool.xml": "<tool name=\"myTool\" namespace=\"Foo\">\n  <schema>\n    type Input = shared.Foos;\n\n    interface Output {\n      shared: Shared;\n    }\n\n    type Shared = {\n      value: string;\n      square: shared.Square;\n    };\n  </schema>\n  <description>\n    Hello\n  </description>\n</tool>\n",
    "prompts/Foo/MyTemplate.xml": "<template name=\"MyTemplate\" namespace=\"Foo\">\n  <schema>\n    interface Input {\n      text: string;\n    }\n\n    interface Output {\n      reversedText: string;\n      shape: shared.Square | { kind: \"circle\"; radius: number };\n    }\n  </schema>\n\n  <tools>\n    - tool: myTool\n  </tools>\n\n  <user>\n    U\n  </user>\n  <system>\n    S\n  </system>\n</template>\n",
