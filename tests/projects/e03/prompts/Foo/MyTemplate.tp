<template name="MyTemplate" namespace="Foo">
  <schema>
    interface Input {
      text: string;
    }

    interface Output {
      reversedText: string;
      shape: shared.Square | { kind: "circle"; radius: number };
    }
  </schema>

  <tools>
    <tool name="myTool" />
  </tools>

  <system>
    S
  </system>

  <user>
    U
  </user>
</template>
