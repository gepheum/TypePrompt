<template name="MyOtherTemplate" namespace="Bar">
  <schema>
    type Input = shared.Square[];

    interface Output {
      items: {
        reversedText: string;
        shape: shared.Square | { kind: "circle"; radius: number };
      }[];
    }
  </schema>

  <tools>
    <tool name="myOtherTool" />
  </tools>

  <system>
    S
  </system>

  <user>
    U
  </user>
</template>
