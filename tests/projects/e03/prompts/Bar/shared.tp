<namespace name="Bar">
  type Foos = string[];

  type Square = {
    kind: "square";
    size: number;
  };

  type SquareHolder = { square: Square };

  type Squares = SquareHolder[];

  type SquaresHolder = { squares: Squares };

  type Node = Leaf | Branch;
  type Leaf = { kind: "leaf"; value: number };
  type Branch = { kind: "branch"; left: Node; right: Node };
</namespace>
