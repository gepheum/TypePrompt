<template name="MyTemplate">
  <schema>
    interface Input {
      text: string;
      omitDefault?: shared.OmitDefaultType;
    }

    interface Output {
      reversedText: string;
      shape: shared.Square | { kind: "circle"; radius: number };
      omitDefault?: shared.OmitDefaultType;
    }
  </schema>
  <system>
    S
  </system>
  <user>
    U
  </user>
</template>
