<template name="InsertOutputSchema">
  <schema>
    interface Input {
      topic: string;
    }

    /**
     * Foo
     */
    interface Foo {
      /** foo */
      foo: integer;
    }
    interface Output {
      title: string;
      score?: number;
      foos: {
        foo: Foo;
      }[];
    }
  </schema>

  <system>
    You are an evaluator.
  </system>

  <user>
    Topic: <insert val="input.topic" />
    Schema:
    <insert schema="Output" format="typescript" />
  </user>
</template>
