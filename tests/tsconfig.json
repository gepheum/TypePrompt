{
  "compilerOptions": {
    "lib": [
      "ES2020"
    ],
    "target": "ES2020",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": [
    "typescript/**/*"
  ]
}