<template name="Foo" namespace="Genoa">
  <config>{ "temperature": 0.75 }</config>

  <schema>
    /** Foo */
    interface Foo {
      input: string;
      dateToday: string;
    }
  </schema>

  <args>
    <arg name="input" />
    <arg name="dateToday" />
  </args>

  <content>
    <system>
    </system>

    <user>
      <maybe>The date today is <arg name="dateToday"/>.
      </maybe>
    </user>

    <examples>
      <example>
        <args>
          <arg name="input">Hello</arg>
          <arg name="dateToday">2024-06-06</arg>
        </args>
        <response>
          {
            "input": "Hello",
            "dateToday": "2024-06-06"
          }
        </response>
      </example>
    </examples>
  </content>
</template>
