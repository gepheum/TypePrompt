<tool name="GetWeather">
  <description>
    
  </description>

  <schema>
    
  </schema>
</tool>

<template name="FooBar" namespace="FooBar">
  <meta>
    {
      "temperature": 0.75,
      "model": "gpt4"
    }
  </meta>

  <schema output-format="xml">
    type Input = {
      dateToday: string;
      weatherToday: string;
      name: string;
      variant: | "default" | "formal";
    };
  </schema>

  <let name="foo" val="not (input.dateToday.notEmpty or input.weatherToday.notEmpty)" />

  <variant name="default" >
    <system>
      Hello <insert val="input.name" format="yaml"/>.

      <insert val="dateToday" wrap-unless-empty="Today is %s."/>.
      <insert snippet="fooSnippet"/>
      <insert snippet="barSnippet"/>

      ## FOO

      ### BAR

      Here is a list: <span if="Foo"> \
      * foo
        * bar
        * <snippet name="_foo"/>
    </system>

    <user>
      The date today is <echo val="input.dateToday"/>
      The weather today is <echo val="input.weatherToday" format="json"/>.
    </user>

    <examples>
      [
        {
        }
        {
        }
      ]
    </examples>
  </variant>

  <snippet name="foo" switch="input.foo">
    <body case="true">
      This is a snippet.
    </body>
    <body case="*">
      This is the false case snippet.
    </body>
  </snippet>

  <snippet name="fooSnippet" switch="(input?.length ?? 0) >= 1">
    <body case="null,true">
    </body>
    <body case="false">
    </body>
  </snippet>

  <snippet name="mySnippet">
    Bonjour bar bar bar.
  </snippet>

  <snippet name="myOtherSnippet" switch="input.foo">
    <case when="true">
      Bonjour bar bar bar.

    </case>
    <case when="false"></case>
  </snippet>
</template>
