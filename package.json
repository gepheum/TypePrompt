{
  "name": "typeprompt-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "make-static-snippets": "tsx packages/cli/src/static-snippets/make-static-snippets.ts",
    "build": "npm run build --workspace=@typeprompt/core && npm run build --workspace=typeprompt && npm run build --workspace=@typeprompt/language-server && npm run build --workspace=typeprompt-vscode && npm run build --workspace=@typeprompt/website",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "website:dev": "npm run dev --workspace=@typeprompt/website",
    "website:build": "npm run build --workspace=@typeprompt/website",
    "start": "node packages/cli/dist/main.js",
    "dev": "tsx packages/cli/src/main.ts",
    "test": "node --import tsx ./node_modules/mocha/bin/mocha.js \"packages/*/src/**/*.test.ts\"",
    "lint": "eslint 'packages/*/src/**/*.ts'",
    "lint:fix": "eslint 'packages/*/src/**/*.ts' --fix",
    "format": "prettier --write \"packages/*/src/**/*.ts\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\""
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.39",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "buckwheat": "^1.1.2",
    "eslint": "^10.0.1",
    "mocha": "^12.0.0-rc.5",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.56.0"
  }
}
