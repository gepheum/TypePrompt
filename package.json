{
  "name": "typeprompt-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "make-static-snippets": "tsx scripts/make-static-snippets.ts",
    "copy-spec-types": "tsx scripts/copy-spec-types.ts",
    "build": "npm run build --workspace=@typeprompt/core && npm run build --workspace=@typeprompt/inference-runner && npm run build --workspace=@typeprompt/formatter && npm run build --workspace=@typeprompt/inference-element && npm run build --workspace=@typeprompt/codemirror && npm run build --workspace=typeprompt && npm run build --workspace=@typeprompt/language-server && npm run build --workspace=typeprompt-vscode && npm run build --workspace=@typeprompt/website",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p scripts/tsconfig.json",
    "website:dev": "npm run dev --workspace=@typeprompt/website",
    "website:build": "npm run build --workspace=@typeprompt/website",
    "start": "node packages/cli/dist/main.js",
    "dev": "tsx packages/cli/src/main.ts",
    "test": "node --import tsx ./node_modules/mocha/bin/mocha.js \"packages/*/{src,dev}/**/*.test.ts\"",
    "lint": "eslint 'packages/*/{src,dev}/**/*.ts' 'scripts/**/*.ts'",
    "lint:fix": "eslint 'packages/*/{src,dev}/**/*.ts' 'scripts/**/*.ts' --fix",
    "format": "prettier --write \"packages/*/{src,dev}/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"packages/*/{src,dev}/**/*.ts\" \"scripts/**/*.ts\""
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "esbuild": "^0.25.0",
    "vitepress": {
      "vite": "^6.4.5"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.39",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "buckwheat": "^1.2.0",
    "eslint": "^10.0.1",
    "mocha": "^11.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.56.0"
  },
  "dependencies": {
    "glob": "14.0.6",
    "minimatch": "11.0.9"
  }
}
