{
  "name": "typeprompt",
  "private": false,
  "type": "module",
  "bin": {
    "typeprompt": "dist/main.js"
  },
  "scripts": {
    "make-static-snippets": "tsx src/static-snippets/make-static-snippets.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "example:prompts": "tsx src/run-prompts-validation.ts",
    "test": "node --import tsx ./node_modules/mocha/bin/mocha.js \"src/**/*.test.ts\"",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\" && playground/format-all.sh",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.39",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "buckwheat": "^1.1.2",
    "eslint": "^10.0.1",
    "mocha": "^12.0.0-rc.5",
    "prettier": "^3.9.5",
    "prettier-plugin-organize-imports": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.56.0"
  },
  "dependencies": {
    "@toon-format/toon": "^4.1.0",
    "smol-toml": "^1.7.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
