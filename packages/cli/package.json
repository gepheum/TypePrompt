{
  "name": "typeprompt",
  "version": "0.1.0",
  "description": "End-to-end type safety for LLM prompts across 8 programming languages",
  "homepage": "https://typeprompt.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/gepheum/typeprompt.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "private": false,
  "files": [
    "dist/",
    "!dist/**/*.test.*"
  ],
  "type": "module",
  "bin": {
    "typeprompt": "dist/main.js"
  },
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "node --import tsx ../../node_modules/mocha/bin/mocha.js \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@toon-format/toon": "^4.1.0",
    "@typeprompt/core": "0.1.0",
    "@typeprompt/formatter": "0.1.0",
    "@typeprompt/inference-runner": "0.1.0",
    "@types/glob-parent": "^5.1.3",
    "glob": "^14.0.6",
    "glob-parent": "^6.0.2",
    "minimatch": "^11.0.9",
    "watcher": "^2.3.1",
    "yaml": "^2.9.0"
  }
}
