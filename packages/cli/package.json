{
  "name": "typeprompt",
  "version": "0.1.0",
  "license": "MIT",
  "private": false,
  "type": "module",
  "bin": {
    "typeprompt": "dist/main.js"
  },
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "node --import tsx ../../node_modules/mocha/bin/mocha.js \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@toon-format/toon": "^4.1.0",
    "@typeprompt/core": "*",
    "@typeprompt/formatter": "*",
    "@typeprompt/inference-runner": "*",
    "@types/glob-parent": "^5.1.3",
    "glob": "^13.0.6",
    "glob-parent": "^6.0.2",
    "minimatch": "^10.2.6",
    "watcher": "^2.3.1",
    "yaml": "^2.9.0"
  }
}
