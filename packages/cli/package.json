{
  "name": "typeprompt",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "bin": {
    "typeprompt": "dist/main.js"
  },
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./formatter": {
      "types": "./dist/formatter/formatter.d.ts",
      "default": "./dist/formatter/formatter.js"
    },
    "./formatter.js": {
      "types": "./dist/formatter/formatter.d.ts",
      "default": "./dist/formatter/formatter.js"
    }
  },
  "scripts": {
    "make-static-snippets": "tsx src/static-snippets/make-static-snippets.ts",
    "play:frontend": "vite src/play/frontend",
    "play:build": "vite build src/play/frontend",
    "build": "tsc -p tsconfig.build.json && npm run play:build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "node --import tsx ../../node_modules/mocha/bin/mocha.js \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@prettier/plugin-xml": "^3.4.2",
    "@typeprompt/core": "*",
    "@types/glob-parent": "^5.1.3",
    "glob": "^13.0.6",
    "glob-parent": "^6.0.2",
    "lit": "^3.2.0",
    "minimatch": "^10.2.6",
    "prettier": "^3.9.6",
    "watcher": "^2.3.1"
  },
  "devDependencies": {
    "vite": "^6.4.4"
  }
}
