{
  "name": "@typeprompt/code-mirror",
  "version": "0.1.0",
  "description": "TypePrompt visual interactive prompt viewer",
  "files": [
    "dist/code-mirror-standalone.js",
    "src/",
    "README.md"
  ],
  "main": "dist/app.js",
  "module": "dist/app.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist",
    "lint": "eslint src/**/*.ts",
    "format": "prettier \"src/**/*.{cjs,html,js,json,md,ts}\" --write",
    "format:check": "prettier \"src/**/*.{cjs,html,js,json,md,ts}\" --check",
    "bundle": "npm run build && rollup -c rollup.standalone.config.js",
    "serve": "npm run build && wds --watch",
    "test": "node --import tsx ../../node_modules/mocha/bin/mocha.js \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.0.2",
    "@codemirror/view": "^6.43.14",
    "@typeprompt/core": "*",
    "@uiw/codemirror-themes-all": "^4.25.9",
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.7",
    "@rollup/plugin-terser": "^1.0.0",
    "@web/dev-server": "^0.4.6",
    "@web/dev-server-import-maps": "^0.3.0",
    "@webcomponents/webcomponentsjs": "^2.8.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.18.0",
    "rollup-plugin-summary": "^2.0.1"
  },
  "customElements": "custom-elements.json"
}