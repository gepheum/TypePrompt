{
  "name": "@typeprompt/playground",
  "version": "0.1.0",
  "description": "Interactive web playground and tRPC contract for TypePrompt",
  "private": false,
  "type": "module",
  "files": [
    "dist/",
    "src/",
    "index.html",
    "README.md"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:tsc": "tsc -p tsconfig.build.json",
    "build:client": "vite build",
    "build": "npm run build:tsc && npm run build:client",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "vite",
    "test": "node --import tsx ../../node_modules/mocha/bin/mocha.js \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.0.2",
    "@codemirror/view": "^6.43.14",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@typeprompt/codemirror": "*",
    "@typeprompt/core": "*",
    "lit": "^3.2.0",
    "nanoevents": "^10.0.0"
  },
  "devDependencies": {
    "vite": "^6.4.5"
  }
}
