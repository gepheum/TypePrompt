{
  "name": "@typeprompt/prompt-viewer",
  "version": "0.1.0",
  "description": "TypePrompt visual interactive prompt viewer",
  "files": [
    "dist/prompt-viewer-standalone.js",
    "src/",
    "README.md"
  ],
  "main": "dist/app.js",
  "module": "dist/app.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist",
    "lint": "eslint src/**/*.ts && lit-analyzer",
    "format": "prettier \"src/**/*.{cjs,html,js,json,md,ts}\" --write",
    "format:check": "prettier \"src/**/*.{cjs,html,js,json,md,ts}\" --check",
    "bundle": "npm run build && rollup -c rollup.standalone.config.js",
    "analyze": "cem analyze --litelement --globs \"src/**/*.ts\"",
    "analyze:watch": "cem analyze --litelement --globs \"src/**/*.ts\" --watch",
    "serve": "npm run build && wds --watch",
    "test": "node --import tsx ../../node_modules/mocha/bin/mocha.js \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@typeprompt/core": "*",
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.6.3",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.7",
    "@rollup/plugin-terser": "^0.4.4",
    "@web/dev-server": "^0.4.6",
    "@web/dev-server-import-maps": "^0.2.1",
    "@web/dev-server-legacy": "^1.0.0",
    "@webcomponents/webcomponentsjs": "^2.8.0",
    "lit-analyzer": "^2.0.3",
    "rimraf": "^6.1.3",
    "rollup": "^4.18.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-summary": "^2.0.1"
  },
  "customElements": "custom-elements.json"
}
