{
  "name": "@typeprompt/language-server",
  "version": "0.9.1",
  "description": "Language Server Protocol (LSP) implementation for TypePrompt",
  "homepage": "https://typeprompt.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/gepheum/typeprompt.git",
    "directory": "packages/language-server"
  },
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "!dist/**/*.test.*"
  ],
  "type": "module",
  "bin": {
    "typeprompt-language-server": "dist/main.js"
  },
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@typeprompt/core": "0.9.1",
    "@typeprompt/formatter": "0.9.1",
    "fast-diff": "^1.3.0",
    "glob": "^14.0.6",
    "minimatch": "^11.0.9",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/fast-diff": "^1.1.0"
  }
}
