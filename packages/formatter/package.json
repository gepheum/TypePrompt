{
  "name": "@typeprompt/formatter",
  "version": "0.1.0",
  "description": "Formatter for TypePrompt (.tp) template files",
  "homepage": "https://typeprompt.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/gepheum/typeprompt.git",
    "directory": "packages/formatter"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "!dist/**/*.test.*"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*",
      "import": "./dist/*",
      "default": "./dist/*"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx ../../node_modules/mocha/bin/mocha.js \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@prettier/plugin-xml": "^3.4.2",
    "@typeprompt/core": "0.1.0",
    "prettier": "^3.9.6"
  }
}
