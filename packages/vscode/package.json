{
  "name": "typeprompt-vscode",
  "displayName": "TypePrompt",
  "description": "VS Code support for TypePrompt templates",
  "version": "0.8.3",
  "publisher": "gepheum",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/gepheum/typeprompt",
    "directory": "packages/vscode"
  },
  "private": true,
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "workspaceContains:**/typeprompt.yaml",
    "workspaceContains:**/typeprompt.yml",
    "workspaceContains:**/.typeprompt.secrets.yaml",
    "workspaceContains:**/.typeprompt.secrets.yml",
    "workspaceContains:**/*.tp"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "typeprompt",
        "aliases": [
          "TypePrompt",
          "typeprompt"
        ],
        "extensions": [
          ".tp"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.svg",
          "dark": "./icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "typeprompt",
        "scopeName": "text.xml.typeprompt",
        "path": "./syntaxes/typeprompt.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "typeprompt.onEnterKey",
        "title": "TypePrompt: Enter Key"
      },
      {
        "command": "typeprompt.toggleComment",
        "title": "TypePrompt: Toggle Comment"
      },
      {
        "command": "typeprompt.openPlayground",
        "title": "TypePrompt: Open Playground",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "typeprompt.openPlayground",
          "when": "resourceFilename =~ /\\.play\\.tp$/",
          "group": "2_open"
        }
      ],
      "editor/title": [
        {
          "command": "typeprompt.openPlayground",
          "when": "resourceFilename =~ /\\.play\\.tp$/ || editorLangId == 'typeprompt'",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "typeprompt.openPlayground",
          "when": "resourceFilename =~ /\\.play\\.tp$/ || editorLangId == 'typeprompt'",
          "group": "1_run"
        }
      ]
    },
    "keybindings": [
      {
        "command": "typeprompt.onEnterKey",
        "key": "enter",
        "when": "editorTextFocus && !editorHasSelection && !editorReadonly && !suggestWidgetVisible && (editorLangId == 'typeprompt' || resourceExtname == '.tp' || resourceFilename =~ /^(typeprompt|\\.typeprompt\\.secrets)\\.ya?ml$/)"
      },
      {
        "command": "typeprompt.toggleComment",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "editorTextFocus && !editorReadonly && (editorLangId == 'typeprompt' || resourceExtname == '.tp' || resourceFilename =~ /^(typeprompt|\\.typeprompt\\.secrets)\\.ya?ml$/)"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node && esbuild ../language-server/src/main.ts --bundle --outfile=dist/server.js --format=cjs --platform=node --minify --banner:js=\"const import_meta_url = require('url').pathToFileURL(__filename).href;\" --define:import.meta.url=import_meta_url",
    "vscode:prepublish": "npm run build && npm run bundle",
    "package": "npx @vscode/vsce package --no-dependencies",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@typeprompt/core": "*",
    "@typeprompt/language-server": "*",
    "vscode-languageclient": "^9.0.1"
  }
}