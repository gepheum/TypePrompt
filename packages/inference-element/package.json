{
  "name": "@typeprompt/inference-element",
  "version": "0.9.1",
  "description": "Web components for rendering TypePrompt playground inference results",
  "homepage": "https://typeprompt.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/gepheum/typeprompt.git",
    "directory": "packages/inference-element"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "!dist/**/*.test.*",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./playground-preview": {
      "types": "./dist/playground-preview.d.ts",
      "import": "./dist/playground-preview.js",
      "default": "./dist/playground-preview.js"
    },
    "./inference-run": {
      "types": "./dist/inference-run.d.ts",
      "import": "./dist/inference-run.js",
      "default": "./dist/inference-run.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js",
      "default": "./dist/theme.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier \"{src,dev}/**/*.{cjs,html,js,json,md,ts}\" --write",
    "format:check": "prettier \"{src,dev}/**/*.{cjs,html,js,json,md,ts}\" --check",
    "dev": "vite",
    "test": "node --import tsx ../../node_modules/mocha/bin/mocha.js \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@typeprompt/core": "0.9.1",
    "lit": "^3.2.0",
    "nanoevents": "^10.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "vite": "^6.4.5"
  }
}
