{
  "name": "@typeprompt/codemirror",
  "version": "0.1.0",
  "description": "CodeMirror 6 extension for TypePrompt",
  "files": [
    "dist/",
    "src/",
    "README.md"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:dev": "tsc -p tsconfig.dev.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist dist-dev",
    "lint": "eslint 'src/**/*.ts' 'dev/**/*.ts'",
    "format": "prettier \"{src,dev}/**/*.{cjs,html,js,json,md,ts}\" --write",
    "format:check": "prettier \"{src,dev}/**/*.{cjs,html,js,json,md,ts}\" --check",
    "serve": "npm run build:dev && wds --config dev/web-dev-server.config.js --watch",
    "test": "node --import tsx ../../node_modules/mocha/bin/mocha.js \"{src,dev}/**/*.test.ts\""
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.0.2",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@typeprompt/core": "*"
  },
  "devDependencies": {
    "@uiw/codemirror-themes-all": "^4.25.9",
    "@web/dev-server": "^0.0.0",
    "@web/dev-server-import-maps": "^0.3.0",
    "@webcomponents/webcomponentsjs": "^2.8.0",
    "lit": "^3.2.0",
    "rimraf": "^6.1.3"
  }
}
